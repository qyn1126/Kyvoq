<UserControl x:Class="Kyvoq.App.Views.SteamAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kyvoq.App.Views"
             xmlns:vm="clr-namespace:Kyvoq.App.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ClipToBounds="True" SizeChanged="View_SizeChanged">
    <UserControl.Resources>
        <ContextMenu x:Key="AccountContextMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ui:MenuItem Header="备注" Icon="{ui:SymbolIcon Edit24}" CommandParameter="{Binding}" Click="Note_Click" />
            <ui:MenuItem Header="删除" Icon="{ui:SymbolIcon Delete24}" CommandParameter="{Binding}" Click="Delete_Click" />
        </ContextMenu>
        <DataTemplate DataType="{x:Type vm:SteamAccountViewModel}">
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" />
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                </Grid>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" CornerRadius="3" Padding="3,0" Margin="3,0,0,0"
                                VerticalAlignment="Center" Background="{DynamicResource SelectedBackgroundBrush}"
                                ToolTip="{Binding Status}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusBadge}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusBadge}" FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding AccountName}" FontSize="11" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SteamAddAccountViewModel}">
            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE710;" FontSize="24"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentBrush}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" Margin="2,0,2,6"
                   FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ListBox x:Name="AccountsListBox" Grid.Row="1" ItemsSource="{Binding Items}"
                 IsEnabled="{Binding CanSwitch}" Background="Transparent" BorderThickness="0" Padding="0"
                 FocusVisualStyle="{x:Null}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewKeyDown="Accounts_KeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Width" Value="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type local:SteamAccountsView}}}" />
                    <Setter Property="Height" Value="56" />
                    <Setter Property="Margin" Value="0,0,6,6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip}" />
                    <Setter Property="ContextMenu" Value="{StaticResource AccountContextMenu}" />
                    <EventSetter Event="MouseDoubleClick" Handler="Account_DoubleClick" />
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="Account_RightClick" />
                    <EventSetter Event="ContextMenuOpening" Handler="Account_ContextMenuOpening" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" CornerRadius="8" Padding="6" ClipToBounds="True"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
